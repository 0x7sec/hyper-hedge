# ==============================================================================
# BYBIT V5 MULTI-PAIR CONCURRENT HEDGE BOT CONFIGURATION (BTC, ETH, SOL)
# ==============================================================================

# ── 1. API Credentials (testnet.bybit.com or bybit.com -> API Management) ─────
# Ensure "Contract" -> "Orders" and "Positions" permissions are checked.
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# ── 2. Portfolio & Network Setup ───────────────────────────────────────────────
# Comma-separated symbols to trade concurrently on Bybit Unified Trading Account
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
LEVERAGE=4
MAX_CONCURRENT_PAIRS=3
TESTNET=true          # true = testnet.bybit.com | false = api.bybit.com (Mainnet)

# ── 3. Execution & Cycle Management ────────────────────────────────────────────
POLL_INTERVAL=15      # Seconds between scans (evaluates indicators on candle closes)
COOLDOWN_SECS=0       # Cooldown seconds after a pair completes cycle (0 = immediate)
MAX_CYCLES=0          # 0 = continuous execution, N = stop after N completed cycles
DRY_RUN=false         # true = simulation mode (live data, no orders), false = live orders
LOG_CSV=bybit_trades.csv

# ── 4. Respective Optimal Champion Parameters (Auto-loaded from defaults) ──────
# Each asset automatically runs its empirically validated champion profile:
#
# • BTCUSDT: 15m candles | EMA(9/21) | ADX > 15 | SL 6.0% (Trail) | TP 2.5% | BE-Lock: ON | Size: 0.007 BTC (~$530)
# • ETHUSDT: 15m candles | EMA(9/21) | ADX > 0  | SL 6.0% (Trail) | TP 2.5% | BE-Lock: ON | Size: 0.20 ETH  (~$500)
# • SOLUSDT: 15m candles | EMA(9/21) | ADX > 15 | SL 6.0% (Trail) | TP 2.5% | BE-Lock: ON | Size: 5.0 SOL   (~$520)
# • XAUUSDT: 5m  candles | EMA(20/50)| ADX > 15 | SL 4.0% (Trail) | TP 4.2% | BE-Lock: OFF| Size: 0.01 XAU   (~$44)
#
# Optional per-pair overrides (uncomment any to customize an individual pair):
# BTC_SIZE=0.007
# BTC_ADX_MIN=15
# ETH_SIZE=0.20
# ETH_ADX_MIN=0
# SOL_SIZE=5.0
# SOL_ADX_MIN=15
